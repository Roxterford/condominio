// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  runtime         = "bun"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlite"
}

//////////////////////////////////////////////////

model Usuario {
  id       String @id @default(cuid())
  email    String @unique
  password String

  IPagosRegistrados  IPago[] @relation(name: "pagos_registrados")
  IPagosActualizados IPago[] @relation(name: "pagos_actualizados")

  PagosRegistrados  Pago[] @relation(name: "pagos_registrados")
  PagosActualizados Pago[] @relation(name: "pagos_actualizados")

  IGastosRegistrados IGasto[] @relation(name: "gastos_registrados")

  GastosRegistrados     Gasto[]    @relation(name: "gastos_registrados")
  CuotasRegistradas     Cuota[]    @relation(name: "cuotas_registradas")
  CuotasActualizadas    Cuota[]    @relation(name: "cuotas_actualizadas")
  ProyectosRegistrados  Proyecto[] @relation(name: "proyectos_registrados")
  ProyectosActualizados Proyecto[] @relation(name: "proyectos_actualizados")

  @@map("usuarios")
}

//////////////////////////////////////////////////

enum EstadoDeProyecto {
  ACTIVO
  BORRADOR
  CERRADO
}

model Proyecto {
  titulo           String
  cuota            String           @id @default(cuid()) // Relación 1:1 estricta
  estado           EstadoDeProyecto @default(BORRADOR)
  descripcion      String
  justificacion    String
  fecha_limite     DateTime
  interes_por_mora Int              @default(0)
  registro         DateTime         @default(now())
  registrado_por   String
  actualizacion    DateTime         @default(now()) @updatedAt
  actualizado_por  String

  Cuota  Cuota   @relation(fields: [cuota], references: [id], onDelete: Cascade)
  Gastos Gasto[]

  Registrador  Usuario @relation(name: "proyectos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario @relation(name: "proyectos_actualizados", fields: [actualizado_por], references: [id])

  @@map("proyectos")
}

//////////////////////////////////////////////////

enum EstadoDeVilla {
  ACTIVA
  INHABITADA
  EXENTA
  EN_LITIGIO
  SUSPENDIDA
  PREVENTA
}

model Villa {
  id     String        @id @default(cuid())
  numero Int           @unique
  estado EstadoDeVilla @default(ACTIVA)

  Deudas  Deuda[]
  Pagos   Pago[]
  IPagos  IPago[]
  IDeudas IDeuda[]

  @@index([numero])
  @@map("villas")
}

//////////////////////////////////////////////////

enum MetodoDePago {
  EFECTIVO
  TRANSFERENCIA
  PAGO_MOVIL
}

enum Moneda {
  VED
  USD
}

model IPago {
  id              String       @id @default(cuid())
  villa           Int
  fecha           DateTime     @default(now())
  metodo          MetodoDePago
  monto           Int
  referencia      String?
  moneda          Moneda
  tasa            Int
  registro        DateTime     @default(now())
  registrado_por  String
  actualizacion   DateTime     @default(now()) @updatedAt
  actualizado_por String

  Villa        Villa           @relation(fields: [villa], references: [numero])
  Registrador  Usuario         @relation(name: "pagos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario         @relation(name: "pagos_actualizados", fields: [actualizado_por], references: [id])
  Destinos     DestinoDePago[]

  @@map("internal_pagos")
}

model DestinoDePago {
  id        String   @id @default(cuid())
  pago      String
  deuda     String
  destinado Int
  fecha     DateTime @default(now())

  IPago  IPago  @relation(fields: [pago], references: [id])
  IDeuda IDeuda @relation(fields: [deuda], references: [id])
  Pago   Pago   @relation(fields: [pago], references: [id])
  Deuda  Deuda  @relation(fields: [deuda], references: [id])

  @@map("destino_de_pagos")
}

view Pago {
  id              String       @unique
  villa           Int
  fecha           DateTime
  metodo          MetodoDePago
  monto           Int
  referencia      String?
  moneda          Moneda
  tasa            Int
  total           Int
  registro        DateTime
  registrado_por  String
  actualizacion   DateTime
  actualizado_por String
  destinado       Int
  cuenta          Int

  Villa        Villa           @relation(fields: [villa], references: [numero])
  Registrador  Usuario         @relation(name: "pagos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario         @relation(name: "pagos_actualizados", fields: [actualizado_por], references: [id])
  Destinos     DestinoDePago[]

  @@map("pagos")
}

//////////////////////////////////////////////////

enum TipoDeCuota {
  SEMILLA // Solo para la deudas iniciales
  REGULAR
  ESPECIAL
}

model Cuota {
  id              String      @id @default(cuid())
  tipo            TipoDeCuota
  monto           Int
  mes             Int
  anio            Int
  registro        DateTime    @default(now())
  registrado_por  String
  actualizacion   DateTime    @default(now()) @updatedAt
  actualizado_por String

  Registrador  Usuario @relation(name: "cuotas_registradas", fields: [registrado_por], references: [id])
  Actualizador Usuario @relation(name: "cuotas_actualizadas", fields: [actualizado_por], references: [id])

  Deudas  Deuda[]
  IDeudas IDeuda[]

  Gastos    Gasto[]
  IGastos   IGasto[]
  Proyectos Proyecto[]

  @@map("cuotas")
}

model Proveedor {
  id            String   @id @default(cuid())
  rif           String   @unique
  nombre        String
  email         String
  telefono      String
  direccion     String?
  registro      DateTime @default(now())
  actualizacion DateTime @default(now()) @updatedAt

  IGastos IGasto[]
  Gastos  Gasto[]

  @@map("proveedores")
}

view Gasto {
  id             String   @unique
  concepto       String
  proveedor      String
  cuota          String?
  monto          Int
  moneda         Moneda
  tasa           Int
  /// Total en USD
  total          Int
  fecha          DateTime @default(now())
  descripcion    String?
  registro       DateTime @default(now())
  registrado_por String

  Proveedor   Proveedor @relation(fields: [proveedor], references: [id])
  Registrador Usuario   @relation(name: "gastos_registrados", fields: [registrado_por], references: [id])
  Cuota       Cuota?    @relation(fields: [cuota], references: [id])
  Proyecto    Proyecto? @relation(fields: [cuota], references: [cuota])

  @@map("gastos")
}

model IGasto {
  id             String   @id @default(cuid())
  concepto       String
  proveedor      String
  cuota          String?
  monto          Int
  moneda         Moneda
  tasa           Int
  fecha          DateTime @default(now())
  descripcion    String?
  registro       DateTime @default(now())
  registrado_por String

  Proveedor Proveedor @relation(fields: [proveedor], references: [id])

  Registrador Usuario @relation(name: "gastos_registrados", fields: [registrado_por], references: [id])
  Cuota       Cuota?  @relation(fields: [cuota], references: [id])

  @@map("internal_gastos")
}

//////////////////////////////////////////////////

enum EstadoDeDeuda {
  PENDIENTE
  ABONADA
  PAGADA
}

model IDeuda {
  id            String   @id @default(cuid())
  villa         Int
  cuota         String
  registro      DateTime @default(now())
  actualizacion DateTime @default(now()) @updatedAt

  Villa Villa           @relation(fields: [villa], references: [numero])
  Cuota Cuota           @relation(fields: [cuota], references: [id])
  Pagos DestinoDePago[]

  @@map("internal_deudas")
}

view Deuda {
  id            String        @unique
  villa         Int
  cuota         String
  /// Este valor es el monto de la cuota
  monto         Int
  /// Este valor es el monto restante de la cuota e ira reduciendose a medida que
  /// se realicen los pagos
  deuda         Int
  estado        EstadoDeDeuda
  registro      DateTime      @default(now())
  actualizacion DateTime      @default(now()) @updatedAt

  Villa Villa           @relation(fields: [villa], references: [numero])
  Cuota Cuota           @relation(fields: [cuota], references: [id])
  Pagos DestinoDePago[]

  @@map("deudas")
}

view Recaudacion {
  cuota             String @unique
  monto             Int
  mes               Int
  anio              Int
  villas            Int
  villas_aplicadas  Int
  villas_solventes  Int
  villas_pendientes Int
  total_estimado    Int
  recaudado         Int
  pendiente         Int
  pagos_asociados   Int

  @@map("recaudacion")
}

////////////////////////////////////////////////

view TasaDeCambio {
  origen    String
  tasa      Int
  fecha     DateTime
  origen_id String

  @@map("tasas_de_cambio")
}

////////////////////////////////////////////////
