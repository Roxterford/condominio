// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlite"
}

//////////////////////////////////////////////////

model Usuario {
  id       String @id @default(cuid())
  email    String @unique
  password String

  IPagosRegistrados  IPago[] @relation(name: "pagos_registrados")
  IPagosActualizados IPago[] @relation(name: "pagos_actualizados")

  PagosRegistrados  Pago[] @relation(name: "pagos_registrados")
  PagosActualizados Pago[] @relation(name: "pagos_actualizados")

  IGastosRegistrados  IGasto[] @relation(name: "gastos_registrados")
  IGastosActualizados IGasto[] @relation(name: "gastos_actualizados")

  GastosRegistrados  Gasto[] @relation(name: "gastos_registrados")
  GastosActualizados Gasto[] @relation(name: "gastos_actualizados")

  @@map("usuarios")
}

//////////////////////////////////////////////////

model Villa {
  id     String @id @default(cuid())
  numero Int    @unique

  Deudas  Deuda[]
  Pagos   Pago[]
  IPagos  IPago[]
  IDeudas IDeuda[]

  @@index([numero])
  @@map("villas")
}

//////////////////////////////////////////////////

enum MetodoDePago {
  EFECTIVO
  TRANSFERENCIA
  PAGO_MOVIL
}

enum Moneda {
  VED
  USD
}

model IPago {
  id              String       @id @default(cuid())
  villa           Int
  fecha           DateTime     @default(now())
  metodo          MetodoDePago
  monto           Int
  referencia      String?
  moneda          Moneda
  tasa            Int
  registro        DateTime     @default(now())
  registrado_por  String
  actualizacion   DateTime     @default(now()) @updatedAt
  actualizado_por String

  Villa        Villa           @relation(fields: [villa], references: [numero])
  Registrador  Usuario         @relation(name: "pagos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario         @relation(name: "pagos_actualizados", fields: [actualizado_por], references: [id])
  Destinos     DestinoDePago[]

  @@map("internal_pagos")
}

model DestinoDePago {
  id        String   @id @default(cuid())
  pago      String
  deuda     String
  destinado Int
  fecha     DateTime @default(now())

  IPago  IPago  @relation(fields: [pago], references: [id])
  IDeuda IDeuda @relation(fields: [deuda], references: [id])
  Pago   Pago   @relation(fields: [pago], references: [id])
  Deuda  Deuda  @relation(fields: [deuda], references: [id])

  @@map("destino_de_pagos")
}

view Pago {
  id              String       @unique
  villa           Int
  fecha           DateTime
  metodo          MetodoDePago
  monto           Int
  referencia      String?
  moneda          Moneda
  tasa            Int
  registro        DateTime
  registrado_por  String
  actualizacion   DateTime
  actualizado_por String
  destinado       Int
  cuenta          Int

  Villa        Villa           @relation(fields: [villa], references: [numero])
  Registrador  Usuario         @relation(name: "pagos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario         @relation(name: "pagos_actualizados", fields: [actualizado_por], references: [id])
  Destinos     DestinoDePago[]

  @@map("pagos")
}

//////////////////////////////////////////////////

model Cuota {
  id            String   @id @default(cuid())
  monto         Int
  mes           Int
  anio          Int
  registro      DateTime @default(now())
  actualizacion DateTime @default(now()) @updatedAt

  Deudas  Deuda[]
  IDeudas IDeuda[]

  Gastos  Gasto[]
  IGastos IGasto[]

  @@map("cuotas")
}

enum TipoDeProveedor {
  PERSONA_NATURAL
  COMPANIA
}

model Proveedor {
  id            String          @id @default(cuid())
  rif           String          @unique
  nombre        String
  tipo          TipoDeProveedor
  email         String
  telefono      String
  direccion     String?
  registro      DateTime        @default(now())
  actualizacion DateTime        @default(now()) @updatedAt

  IGastos IGasto[]
  Gastos  Gasto[]

  @@map("proveedores")
}

view Gasto {
  id              String   @unique
  proveedor       String
  cuota           String?
  monto           Int
  moneda          Moneda
  tasa            Int
  /// Total en USD
  total           Int
  fecha           DateTime @default(now())
  descripcion     String?
  registro        DateTime @default(now())
  actualizacion   DateTime @default(now()) @updatedAt
  registrado_por  String
  actualizado_por String

  Proveedor    Proveedor @relation(fields: [proveedor], references: [id])
  Registrador  Usuario   @relation(name: "gastos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario   @relation(name: "gastos_actualizados", fields: [actualizado_por], references: [id])
  Cuota        Cuota?    @relation(fields: [cuota], references: [id])

  @@map("gastos")
}

model IGasto {
  id              String   @id @default(cuid())
  proveedor       String
  cuota           String?
  monto           Int
  moneda          Moneda
  tasa            Int
  fecha           DateTime @default(now())
  descripcion     String?
  registro        DateTime @default(now())
  actualizacion   DateTime @default(now()) @updatedAt
  registrado_por  String
  actualizado_por String

  Proveedor Proveedor @relation(fields: [proveedor], references: [id])

  Registrador  Usuario @relation(name: "gastos_registrados", fields: [registrado_por], references: [id])
  Actualizador Usuario @relation(name: "gastos_actualizados", fields: [actualizado_por], references: [id])
  Cuota        Cuota?  @relation(fields: [cuota], references: [id])

  @@map("internal_gastos")
}

//////////////////////////////////////////////////

enum EstadoDeDeuda {
  PENDIENTE
  ABONADA
  PAGADA
}

model IDeuda {
  id            String   @id @default(cuid())
  villa         Int
  cuota         String
  registro      DateTime @default(now())
  actualizacion DateTime @default(now()) @updatedAt

  Villa Villa           @relation(fields: [villa], references: [numero])
  Cuota Cuota           @relation(fields: [cuota], references: [id])
  Pagos DestinoDePago[]

  @@map("internal_deudas")
}

view Deuda {
  id            String        @unique
  villa         Int
  cuota         String
  /// Este valor es el monto de la cuota
  monto         Int
  /// Este valor es el monto restante de la cuota e ira reduciendose a medida que
  /// se realicen los pagos
  deuda         Int
  estado        EstadoDeDeuda
  registro      DateTime      @default(now())
  actualizacion DateTime      @default(now()) @updatedAt

  Villa Villa           @relation(fields: [villa], references: [numero])
  Cuota Cuota           @relation(fields: [cuota], references: [id])
  Pagos DestinoDePago[]

  @@map("deudas")
}

//////////////////////////////////////////////////
