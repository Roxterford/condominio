type Gasto @paginable {
  id: ID!
  concepto: String!
  proveedor: String!
  cuota: ID
  monto: Int!
  moneda: String! # TODO: Moneda
  tasa: Int!
  total: Int!
  fecha: DateTime!
  descripcion: String
  registro: DateTime!
  registrado_por: String!
}
# Code generated by tools/autopaginated/main.go
type PaginatedGasto {
  data: [Gasto!]!
  total: Int!
  page: Int!
  pages: Int!
  limit: Int!
}
