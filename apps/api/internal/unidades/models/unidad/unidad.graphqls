enum EstadoDeUnidad {
  ACTIVA
  INHABITADA
  EXENTA
  EN_LITIGIO
  SUSPENDIDA
  PREVENTA
}

type Unidad @paginable {
  id: String!
  codigo: String!
  estado: EstadoDeUnidad!
  titular_primario: Titular
  contacto: Persona
  deuda: Float!
  wallet: Float!
}

type UnidadIdentifiers {
  id: ID!
  codigo: String!
}

# Code generated by tools/autopaginated/main.go
type PaginatedUnidad {
  data: [Unidad!]!
