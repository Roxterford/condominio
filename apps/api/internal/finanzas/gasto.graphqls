interface Gasto {
  operacion: ID!
  transaccion: ID
  cuota: ID
  fecha: DateTime!
  concepto: String!
  monto: Float!
  moneda: Moneda!
  total: Float!
  metodo: MetodoDeOperacion!
  tasa: Float!
  registrado_por: String!
  registro: DateTime!
}

type GastoAProveedor implements Gasto {
  operacion: ID!
  transaccion: ID
  cuota: ID
  fecha: DateTime!
  concepto: String!
  monto: Float!
  moneda: Moneda!
  total: Float!
  metodo: MetodoDeOperacion!
  tasa: Float!
  registrado_por: String!
  registro: DateTime!
  proveedor: Proveedor!
}

type GastoACondominio implements Gasto {
  operacion: ID!
  transaccion: ID
  cuota: ID
  fecha: DateTime!
  concepto: String!
  monto: Float!
  moneda: Moneda!
  total: Float!
  metodo: MetodoDeOperacion!
  tasa: Float!
  registrado_por: String!
  registro: DateTime!
}

union GastoType = GastoACondominio | GastoAProveedor

# Code generated by tools/autopaginated/main.go
type PaginatedGasto {
  data: [GastoType!]!
  total: Int!
  page: Int!
  pages: Int!
  limit: Int!
}
