enum TipoDeMovimiento {
  Debito
  Credito
}

enum RolDelMovimiento {
  UNIDAD
  PROVEEDOR
  CONDOMINIO
}

type Operacion @paginable {
  id: String!
  fecha: DateTime!
  concepto: String!
  monto: Float!
  moneda: Moneda!
  metodo: MetodoDeOperacion!
  tasa: Float!
  tipo: TipoDeMovimiento!
  rol: RolDelMovimiento!
  cuota: ID
  registrado_por: String!
  registro: DateTime!
  unidad_codigo: String
  proveedor: String
  unidad: Unidad
}
# Code generated by tools/autopaginated/main.go
type PaginatedOperacion {
  data: [Operacion!]!
  total: Int!
  page: Int!
  pages: Int!
  limit: Int!
}
