enum TipoDeOperacion {
  Debito
  Credito
}

enum RolDestinoDeOperacion {
  Unidad
  Proveedor
  Condominio
}

interface IOperacion {
  operacion: ID!
  concepto: String!
  monto: Float!
  fecha: DateTime!
  moneda: Moneda!
  metodo: MetodoDeOperacion!
  tasa: Float!
  total: Float!
  registrado_por: String!
  registro: DateTime!
}

type Operacion @paginable {
  id: String!
  fecha: DateTime!
  concepto: String!
  monto: Float!
  moneda: Moneda!
  metodo: MetodoDeOperacion!
  total: Float!
  tasa: Float!
  tipo: TipoDeOperacion!
  rol: RolDestinoDeOperacion!
  cuota: ID
  registrado_por: String!
  registro: DateTime!
  unidad_codigo: String
  proveedor: String
  unidad: Unidad
}
# Code generated by tools/autopaginated/main.go
type PaginatedOperacion {
  data: [OperacionType!]!
  total: Int!
  page: Int!
  pages: Int!
  limit: Int!
}

union OperacionType = Pago | GastoACondominio | GastoAProveedor
