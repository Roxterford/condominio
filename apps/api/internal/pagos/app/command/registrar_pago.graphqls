input RegistrarPagoDTO {
  unidad: String!
  fecha: DateTime
  metodo: MetodoDePago!
  referencia: String!
  monto: Int!
  tasa: Int!
  moneda: Moneda!
}

extend type Mutation {
  registrarPago(input: RegistrarPagoDTO!): Boolean!
}
