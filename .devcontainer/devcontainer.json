{
  "name": "Condominio Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "forwardPorts": [4000, 3001],
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "remoteUser": "devuser",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "golang.go"
      ]
    }
  }
}
