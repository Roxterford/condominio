      "index": "bA3",
      "roundness": null,
      "seed": 498592513,
      "version": 339,
      "versionNonce": 916273592,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785853781252,
      "locked": false,
      "text": "El movimiento es el desglose\ncontable de un hecho físico.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El movimiento es el desglose contable de un hecho físico.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "wac6GXEYpYMb68Z9TZjiF",
      "type": "text",
      "x": 474.3280697388095,
      "y": 2402.4331412557867,
      "width": 607.4114916919029,
      "height": 70,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "I0f0yr3aE6fnda6GCNdx7",
      "index": "bA4",
      "roundness": null,
      "seed": 543482593,
      "version": 796,
      "versionNonce": 2016828872,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785853781252,
      "locked": false,
      "text": "Se refiere a que movimiento de DEBITO\nsera destinado a una cuota",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se refiere a que movimiento de DEBITO sera destinado a una cuota",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "ThC2LjdPkhtllDmtWOYCh",
      "type": "text",
      "x": -438.3844497991631,
      "y": 2697.266088061717,
      "width": 510.07429872726584,
      "height": 175,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "I0f0yr3aE6fnda6GCNdx7",
      "index": "bA5",
      "roundness": null,
      "seed": 1449647809,
      "version": 1129,
      "versionNonce": 322781880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785853781252,
      "locked": false,
      "text": "Es la entidad central que representa\nuna cuota de condominio periódica\n(mensual). Cada Cuota define el\nmonto que deben pagar las unidades\npara un mes/año específico.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es la entidad central que representa una cuota de condominio periódica (mensual). Cada Cuota define el monto que deben pagar las unidades para un mes/año específico.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "DKc2yKA4oxzSdWBiuXFix",
      "type": "text",
      "x": -19.857164758414,
      "y": 3459.7464613224347,
      "width": 510.07429872726584,
      "height": 35,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "I0f0yr3aE6fnda6GCNdx7",
      "index": "bA6",
      "roundness": null,
      "seed": 1851809441,
      "version": 1208,
      "versionNonce": 1010263240,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785853781252,
      "locked": false,
      "text": "Registra qué unidad debe qué cuota",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Registra qué unidad debe qué cuota",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "9LYQaUsnuwcoUyV_B0ti7",
      "type": "text",
      "x": -1386.9547911696845,
      "y": 3122.0456356504237,
      "width": 440.2865766744914,
      "height": 70,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "I0f0yr3aE6fnda6GCNdx7",
      "index": "bA7",
      "roundness": null,
      "seed": 385737345,
      "version": 521,
      "versionNonce": 1358179256,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785853781252,
      "locked": false,
      "text": "Indica que movimiento fue\ndestinado a pagar una deuda",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Indica que movimiento fue destinado a pagar una deuda",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "62AuwDhtV_ZdzK-LHRzzw",
      "type": "text",
      "x": -3299.036314640316,
      "y": 3484.854710140642,
      "width": 440.2865766744914,
      "height": 34.99999999999999,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffec99",
