    {
      "id": "0-YNb5H8de5h530pQVGrM",
      "type": "text",
      "x": -2745.832943676962,
      "y": 3129.2044824449886,
      "width": 440.2865766744914,
      "height": 70,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
